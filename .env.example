# Azure Speech resource for azure-wuu (wuu-CN).
AZURE_SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_SPEECH_KEY=<key>

# Gemini API key for gemini-argon (live, or scripts/gemini_batch.py at half price).
GEMINI_API=<key>

# Optional: where Whisper-medium-Wu lives (default: models/whisper-medium-wu/whisper, from scripts/fetch_models.py)
# WU_WHISPER_DIR=
# U2PP_WU_DIR=      (default: models/conformer-u2pp-wu)
# DOLPHIN_DIR=      (default: models/dolphin-cn-dialect-small)
